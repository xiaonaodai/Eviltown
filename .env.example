# EvilTown · LLM settings
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your key.
# `.env` is listed in .gitignore, so it never reaches GitHub.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
#
# Leave it empty and the town still runs — wishes, diaries and chats
# fall back to built-in templates. Nothing crashes.
#
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Moonshot,
# Qwen, Ollama, LM Studio, llama.cpp ...).

EVILTOWN_LLM_BASE_URL=https://api.openai.com/v1
EVILTOWN_LLM_MODEL=gpt-4o-mini
EVILTOWN_LLM_KEY=

# Generation language for diaries / chats: zh or en.
# At runtime the web UI overrides this (it follows the UI language).
EVILTOWN_LLM_LANG=zh

# ---------------------------------------------------------------------------
# 中文说明
# ---------------------------------------------------------------------------
# 1. 把本文件复制成 `.env`，填上你的密钥。
# 2. `.env` 已被 .gitignore 排除，不会进 GitHub。
# 3. 不填也能跑：愿望 / 日记 / 聊天自动退回内置模板，不会报错。
# 4. 兼容任何 OpenAI 格式的接口（OpenAI、DeepSeek、Kimi、通义、
#    Ollama、LM Studio、llama.cpp 都行）。
# 5. 生成语言 zh / en，默认跟随网页界面语言。
